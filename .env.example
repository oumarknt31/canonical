# Copy to .env and paste your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned so every result uses one model. Free tier (checked Nov 20, 2026): 15 requests/min, 500/day.
# Gemini 3.8 Flash allows only 20/day, too few for the ablation; Gemma 4 was overloaded when tested.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=
# Free tier: keep calls under the per-minute limit for your key
GEMINI_RPM=14
